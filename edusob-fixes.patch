From 96d574314da2019e644d64310c944e357f1587fd Mon Sep 17 00:00:00 2001
From: Code Audit <agent@edusob.local>
Date: Thu, 3 Sep 2026 15:13:31 +0000
Subject: [PATCH] fix: SQLite double-quoted literals -> single quotes
 (node:sqlite DQS breaks); PORT env support

---
 server.ts                    | 2 +-
 src/routes/admin.ts          | 2 +-
 src/routes/scholarships.ts   | 2 +-
 src/routes/teacherSupport.ts | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/server.ts b/server.ts
index 6775b42..2e6b9e7 100644
--- a/server.ts
+++ b/server.ts
@@ -7,7 +7,7 @@ app.use('/static/*', serveStatic({ root: './public' }))
 app.use('/samples/*', serveStatic({ root: './public' }))
 app.use('/favicon.ico', serveStatic({ path: './public/favicon.ico' }))
 
-const port = 3000
+const port = Number(process.env.PORT) || 3000
 const hostname = '0.0.0.0'
 
 console.log(`EduSob server starting on http://${hostname}:${port}...`)
diff --git a/src/routes/admin.ts b/src/routes/admin.ts
index b422f0b..b923451 100644
--- a/src/routes/admin.ts
+++ b/src/routes/admin.ts
@@ -89,7 +89,7 @@ admin.get('/stats', async (c) => {
       safeCount(DB, "SELECT COUNT(*) n FROM announcements WHERE status = 'approved'"),
       safeCount(DB, 'SELECT COUNT(*) n FROM teachers WHERE is_active = 1'),
       safeCount(DB, 'SELECT COUNT(*) n FROM teachers WHERE is_online = 1 AND is_active = 1'),
-      safeCount(DB, 'SELECT COUNT(*) n FROM teacher_tickets WHERE status = "answered"'),
+      safeCount(DB, "SELECT COUNT(*) n FROM teacher_tickets WHERE status = 'answered'"),
       safeCount(DB, "SELECT COUNT(*) n FROM payment_requests WHERE status = 'pending'"),
       safeCount(DB, "SELECT COUNT(*) n FROM assisted_requests WHERE status IN ('requested','paid','processing')"),
       safeCount(DB, "SELECT COUNT(*) n FROM teacher_tickets WHERE status = 'pending'"),
diff --git a/src/routes/scholarships.ts b/src/routes/scholarships.ts
index b146ea6..83ea33b 100644
--- a/src/routes/scholarships.ts
+++ b/src/routes/scholarships.ts
@@ -33,7 +33,7 @@ const handleGetPublicList = async (c: any) => {
     params.push(category)
   }
   if (level && level !== 'all') {
-    query += ' AND (target_level=? OR target_level="all")'
+    query += " AND (target_level=? OR target_level='all')"
     params.push(level)
   }
   if (q) {
diff --git a/src/routes/teacherSupport.ts b/src/routes/teacherSupport.ts
index aa670a4..f478098 100644
--- a/src/routes/teacherSupport.ts
+++ b/src/routes/teacherSupport.ts
@@ -527,7 +527,7 @@ const handleGetAdminTickets = async (c: any) => {
     query += ' WHERE t.status = ?'
     params.push(status)
   }
-  query += ' ORDER BY CASE WHEN t.urgency="urgent" AND t.status="pending" THEN 1 WHEN t.status="pending" THEN 2 ELSE 3 END, t.id DESC LIMIT 100'
+  query += " ORDER BY CASE WHEN t.urgency='urgent' AND t.status='pending' THEN 1 WHEN t.status='pending' THEN 2 ELSE 3 END, t.id DESC LIMIT 100"
 
   const { results } = await c.env.DB.prepare(query).bind(...params).all()
   return c.json({ ok: true, tickets: results || [] })
